package __APP_ID__

import android.content.Context
import android.net.ConnectivityManager
import android.net.Network
import android.net.NetworkCapabilities
import android.net.NetworkRequest
import android.os.Handler
import android.os.Looper
import io.flutter.plugin.common.BinaryMessenger
import io.flutter.plugin.common.EventChannel
import io.flutter.plugin.common.MethodCall
import io.flutter.plugin.common.MethodChannel

/**
 * MethodChannel `jormungand/network` + EventChannel `jormungand/network_events` (Dart side:
 * lib/platform/network_channel.dart): is the network the phone really uses a metered one. Settings ->
 * Data "Auto-download" (Wi-Fi only) asks it; the core downloads an update only while it says "no".
 *
 *  metered -> Boolean   now
 *  type    -> String    wifi | ethernet | mobile | other | none (the support report's network.host)
 *  events: Boolean      every change (and the current value at once on listen)
 *  state events (`jormungand/network_state`): Map  {connected, validated, captive, type, id} of the underlying
 *                       default network (DefaultNetworkMonitor.addStateListener), the current one at once on
 *                       listen; the app forwards each to the core's Sentinel (CoreApi.setNetwork)
 *
 * Our own VPN declares itself unmetered, so `activeNetwork` would answer "unmetered" through a
 * cellular link while the tunnel is up. The answer is therefore taken from the underlying
 * (non-VPN) networks: unmetered = some validated internet network that is not a VPN has
 * NET_CAPABILITY_NOT_METERED.
 */
class NetworkChannel(private val app: Context) {
    companion object {
        const val NAME = "jormungand/network"
        const val EVENTS = "jormungand/network_events"
        const val STATE = "jormungand/network_state"

        /** [metered] without a channel: the background update job asks it when it runs (no Dart app to ask). */
        fun isMetered(app: Context): Boolean = isMetered(app.getSystemService(ConnectivityManager::class.java))

        @Suppress("DEPRECATION")
        private fun isMetered(cm: ConnectivityManager): Boolean = try {
            val unmetered = cm.allNetworks.any { n ->
                val c = cm.getNetworkCapabilities(n)
                c != null &&
                    c.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) &&
                    !c.hasTransport(NetworkCapabilities.TRANSPORT_VPN) &&
                    c.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED) &&
                    c.hasCapability(NetworkCapabilities.NET_CAPABILITY_NOT_METERED)
            }
            !unmetered
        } catch (e: Throwable) {
            true // unknown: do not spend the user's traffic
        }
    }

    private val main = Handler(Looper.getMainLooper())
    private val cm: ConnectivityManager = app.getSystemService(ConnectivityManager::class.java)
    private var sink: EventChannel.EventSink? = null
    private var last: Boolean? = null
    private var stateSink: EventChannel.EventSink? = null
    private var stateListener: ((Map<String, Any?>) -> Unit)? = null

    private val callback = object : ConnectivityManager.NetworkCallback() {
        override fun onAvailable(network: Network) = recheck()
        override fun onLost(network: Network) = recheck()
        override fun onCapabilitiesChanged(network: Network, caps: NetworkCapabilities) = recheck()
    }

    fun register(messenger: BinaryMessenger) {
        MethodChannel(messenger, NAME).setMethodCallHandler(::onCall)
        EventChannel(messenger, EVENTS).setStreamHandler(object : EventChannel.StreamHandler {
            override fun onListen(arguments: Any?, events: EventChannel.EventSink?) {
                sink = events
                last = null
                // the default request is NOT_VPN + NOT_RESTRICTED: the underlying networks only
                val request = NetworkRequest.Builder()
                    .addCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET)
                    .build()
                runCatching { cm.registerNetworkCallback(request, callback) }
                recheck()
            }

            override fun onCancel(arguments: Any?) {
                runCatching { cm.unregisterNetworkCallback(callback) }
                sink = null
            }
        })
        EventChannel(messenger, STATE).setStreamHandler(object : EventChannel.StreamHandler {
            override fun onListen(arguments: Any?, events: EventChannel.EventSink?) {
                val e = events ?: return
                stateListener?.let { DefaultNetworkMonitor.removeStateListener(it) }
                stateSink = e
                val l: (Map<String, Any?>) -> Unit = { s -> main.post { if (stateSink === e) e.success(s) } }
                stateListener = l
                DefaultNetworkMonitor.addStateListener(app, l)
            }

            override fun onCancel(arguments: Any?) {
                stateListener?.let { DefaultNetworkMonitor.removeStateListener(it) }
                stateListener = null
                stateSink = null
            }
        })
    }

    private fun onCall(call: MethodCall, result: MethodChannel.Result) {
        when (call.method) {
            "metered" -> result.success(metered())
            "type" -> result.success(networkType())
            else -> result.notImplemented()
        }
    }

    /**
     * What the phone is really on, for the support report: `wifi` | `ethernet` | `mobile` | `other` |
     * `none`. The underlying (non-VPN) validated internet networks only, as in [metered]; Wi-Fi wins
     * when several are up.
     */
    @Suppress("DEPRECATION")
    private fun networkType(): String = try {
        val kinds = cm.allNetworks.mapNotNull { n ->
            val c = cm.getNetworkCapabilities(n)
            if (c == null ||
                !c.hasCapability(NetworkCapabilities.NET_CAPABILITY_INTERNET) ||
                c.hasTransport(NetworkCapabilities.TRANSPORT_VPN) ||
                !c.hasCapability(NetworkCapabilities.NET_CAPABILITY_VALIDATED)
            ) {
                null
            } else when {
                c.hasTransport(NetworkCapabilities.TRANSPORT_WIFI) -> "wifi"
                c.hasTransport(NetworkCapabilities.TRANSPORT_ETHERNET) -> "ethernet"
                c.hasTransport(NetworkCapabilities.TRANSPORT_CELLULAR) -> "mobile"
                else -> "other"
            }
        }
        listOf("wifi", "ethernet", "mobile", "other").firstOrNull { it in kinds } ?: "none"
    } catch (e: Throwable) {
        "unknown"
    }

    private fun metered(): Boolean = isMetered(cm)

    private fun recheck() {
        // the callbacks come on a system thread, a capabilities change may be followed by more of them
        main.post {
            val s = sink ?: return@post
            val now = metered()
            if (now != last) {
                last = now
                s.success(now)
            }
        }
    }
}
