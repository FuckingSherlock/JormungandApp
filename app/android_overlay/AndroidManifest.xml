<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- libbox: the default network and its interfaces (CHANGE_NETWORK_STATE: requestNetwork on Android 9-11) -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- VPN service runs in the foreground; Android 14+ wants a type + its permission.
         specialUse (subtype "vpn", see the <property> below): sing-box-for-android does the same.
         Play Store would ask for a declaration; we ship the APK ourselves (self-update).
         Alternative: android.permission.FOREGROUND_SERVICE_SYSTEM_EXEMPTED + foregroundServiceType="systemExempted". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13+: the ongoing "connected" notification (runtime permission, requested by the app) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- "Allow the app to always run in the background" dialog (Settings -> Connection -> Work in the background;
         asked once after the first connect): Doze and the vendors' task killers stop the tunnel's helpers otherwise -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- self-update: install the downloaded APK -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Rules -> Per-app routing lists every installed app (Android 11+ hides the others otherwise);
         like the self-update above, this is for the APK we ship ourselves, not for a store -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <!-- Nodes -> + -> Scan QR code (flutter_zxing over the camera plugin; runtime permission, asked on first scan).
         The camera is optional: a device without one still installs the app. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:label="Jormungand"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- The tunnel. BIND_VPN_SERVICE: only the system may bind it. stopWithTask=false: swiping the app
             from Recents must not stop the tunnel (nor the engine with the Dart core, see AppEngine.kt). -->
        <service
            android:name=".JormungandVpnService"
            android:exported="false"
            android:stopWithTask="false"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn"/>
        </service>

        <!-- After the app's own update (in the app or sideloaded) the VPN comes back if it was on: the system
             sends this to the replaced package (ResumeAfterUpdate.kt). exported=false: only the system sends it. -->
        <receiver
            android:name=".ResumeReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Quick Settings tile (JormungandTileService.kt). Not an ACTIVE_TILE on purpose: the system binds it
             on every shade open, so its state is read fresh. TOGGLEABLE: a switch for accessibility (API 30+). -->
        <service
            android:name=".JormungandTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE"/>
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true"/>
        </service>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
